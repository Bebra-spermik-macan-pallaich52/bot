DB_PASSWORD=replace_with_a_long_random_password
SYMBOL=BTCUSDT
CATEGORY=linear
BACKFILL_DAYS=30
MIN_EVENTS=30
# Freeze this UTC epoch-millisecond boundary before examining test outcomes.
# Empty = exploratory 70/30 chronological split, not a fresh holdout each run.
TEST_START_MS=
# Round-trip cost sensitivity in basis points; not a trading simulation.
COST_BPS=10

# Dashboard is bound to this computer only.
DASHBOARD_PORT=8080

# 10-minute classes: down below -0.10%, flat within +/-0.10%, up above +0.10%.
FORECAST_BAND_BPS=10
